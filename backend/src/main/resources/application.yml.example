server:
  port: 8080
  servlet:
    encoding:
      charset: UTF-8
      force: true

spring:
  application:
    name: hr-backend

  # ---------- MySQL（allowPublicKeyRetrieval + useSSL=false 是 MySQL 9 的必须项） ----------
  # 注意：连接池不设 connection-test-query —— MySQL 驱动支持 JDBC4 isValid()，交给 Hikari 自带的校验更快
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://127.0.0.1:3306/hr_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false&rewriteBatchedStatements=true
    username: hr_app
    # 口令不入库：复制本文件为 application.yml 后填入真实值（见 .local/credentials.md）
    password: "***REMOVED***"
    hikari:
      pool-name: HrHikariPool
      minimum-idle: 5
      maximum-pool-size: 20
      connection-timeout: 30000
      idle-timeout: 600000
      max-lifetime: 1800000

  # ---------- Redis（VMware Ubuntu 虚拟机；NAT+DHCP，IP 可能漂，连不上先查 IP） ----------
  data:
    redis:
      host: 192.168.30.128
      port: 6379
      password: "***REMOVED***"
      database: 0
      timeout: 3000ms
      lettuce:
        pool:
          max-active: 16
          max-idle: 8
          min-idle: 2
          max-wait: 3000ms

  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: GMT+8

# ---------- MyBatis-Plus ----------
# 全部自定义 SQL 均以 @Select 写在 Mapper 接口里，没有 XML，故不配 mapper-locations
mybatis-plus:
  type-aliases-package: com.yang.hr.entity
  configuration:
    map-underscore-to-camel-case: true
    cache-enabled: false
  global-config:
    banner: false
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

logging:
  level:
    root: info
    com.yang.hr: debug

# ---------- Sa-Token 鉴权 ----------
# 前端调用时把 token 放在请求头 satoken 里（token-name 就是头名）
sa-token:
  token-name: satoken
  timeout: 7200          # token 有效期（秒）= 2 小时
  active-timeout: -1     # 不做最低活跃频率限制，只在 timeout 后过期
  is-concurrent: true    # 允许同账号多端同时登录
  is-share: false        # 每次登录都发新 token（便于演示"踢人下线"）
  token-style: uuid
  is-read-cookie: false  # 前后端分离，只认请求头，不读 Cookie
  is-read-header: true
  is-print: false        # 关掉 Sa-Token 启动 banner，保持日志干净
  is-log: false          # 关掉每次鉴权的 DEBUG 级日志

# ---------- 业务自定义配置 ----------
hr:
  upload:
    # 上传根目录。不配则默认 ./uploads，按进程工作目录解析 —— IDEA 与 mvn 启动的 CWD
    # 可能不同，会出现"上传成功但图片 404"。显式写死本机路径；打包迁移时用环境变量
    # HR_UPLOAD_DIR 覆盖即可（UploadConfig.resolveRoot 统一解析，静态映射与写盘共用）。
    dir: ${HR_UPLOAD_DIR:./uploads}
  security:
    login-max-fail: 3      # 连续输错几次后锁定
    login-lock-minutes: 5  # 锁定时长（分钟）
